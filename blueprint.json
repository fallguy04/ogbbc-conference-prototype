{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Annual Conference prototype",
    "author": "ogbbc.org webmasters"
  },
  "landingPage": "/annual-conference/dev-signout/?return=%2Fannual-conference%2F%3Fyear%3D2026%26as-of%3D2026-05-29T09%3A00%26tz%3DAmerica%2FIndiana%2FIndianapolis",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "steps": [
    {
      "step": "defineWpConfigConsts",
      "consts": {
        "OGC_DEV": true,
        "OGC_PROTOTYPE": true
      }
    },
    {
      "step": "setSiteOptions",
      "options": {
        "permalink_structure": "/%postname%/",
        "blogname": "Old German Baptist Brethren Church, New Conference",
        "timezone_string": "America/New_York"
      }
    },
    {
      "step": "installTheme",
      "themeData": { "resource": "url", "url": "https://raw.githubusercontent.com/fallguy04/ogbbc-conference-prototype/main/ogbbc-standin.zip" },
      "options": { "activate": true }
    },
    {
      "step": "installPlugin",
      "pluginData": { "resource": "url", "url": "https://raw.githubusercontent.com/fallguy04/ogbbc-conference-prototype/main/ogc-conference.zip" },
      "options": { "activate": true }
    }
  ]
}
